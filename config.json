{
    "labels_path": "$APP/labels_de.json",
    "local_path": "$HOME/AppData/Local/Cirdan/",
    "target_path": "$HOME/Documents/",
    "log_path": "$HOME/Documents/_logs/",
    "update_path": "P:/Cirdan/",
    "domain": "example.net",
    "destinations": {
        "Import directory 1": {"sub_path": "import1", "triggers": "selection"},
        "Import directory 2": {"sub_path": "import2", "triggers": "static"},
        "Import directory 3": {"sub_path": "import3", "triggers": "static"}
    },
    "app_name": "Cirdan",
    "triggers": {
        "static": ["AW für Ermittler"],
        "selection": [
            "AW für Ermittler",
            "BU für Dir 1 IuK",
            "BU für Dir 2 IuK",
            "BU für Dir 3 IuK",
            "BU für Dir 4 IuK",
            "BU für Dir 5 IuK",
            "BU für LKA 814"
        ]
    },
    "settings_name": "settings.json",
    "log_name": "log.txt",
    "lastlog_name": "lastlog.txt",
    "crashlog_name": "crashlog.txt",
    "tsv_name": "md5.txt",
    "trigger_name": "fertig.txt",
    "qualicheck_name": "qualicheck.txt",
    "source_whitelist": [
        "^[0-9]{6}-([0-9]{4}|[0-9]{6})-(([iZ0-9][0-9]{5})|(StA[0-9]{3}))/(EAV|MSD)[0-9]{2}[A-Z]{3}[0-9A-Z]{4}.*"
    ],
    "max_path_length": 230,
	"max_hash_size": 1073741824,
    "source_blacklist": [
        "^[^/]+/(?!((EAV|MSD)[0-9]{2}[A-Z]{3}[0-9A-Z]{4})|(.*\\.(txt|pdf)$))",
        ".*/Help/HTML5/.*",
        ".*/Help/LicenseUpgrade/.*"
    ],
    "destination_blacklist": [
        "^[^/]*/fertig.txt",
        "^[^/]*/fehler.txt",
        "^[^/]*/start.txt",
        "^[^/]*/zu_loeschen.txt"
    ],
	"mail": {
        "smtp_host": "smtpt.msd.example.net",
        "smtp_port": 25,
        "smtp_timeout": 30,
        "From": "From <from@example.net>",
        "Reply-To": "reply-to@example.net",
        "Subject": "Cirdan: Import von % wurde durchgeführt",
        "body": "Hallo Nutzer,\n\ndies ist eine vom Upload-Tool Cirdan automatisch generierte Benachrichtigung.\n\nDer Upload wurde durchgeführt.\n\nVerzeichnis: %\nGesamtgröße: %\nAnzahl der Dateien: %\nDavon nicht kopiert: %\nDavon fehlerhaft: %\n\nBeste Grüße\n\nSupport-Team\n"
    }
}
