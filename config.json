{
    "labels_path": "$APP/labels_en.json",
    "mail_template_path": "$APP/mail_template.json",
    "local_path": "$HOME/AppData/Local/Cirdan/",
    "target_path": "$HOME/Documents/",
    "log_path": "$HOME/Documents/_logs/",
    "mail_path": "$HOME/Documents/_mail/",
    "update_path": "P:/Cirdan/",
    "domain": "example.net",
    "destinations": {
        "Import directory 1": "import1",
        "Import directory 2": "import2",
        "Import directory 3": "import3"
    },
    "settings_name": "settings.json",
    "log_name": "log.txt",
    "lastlog_name": "lastlog.txt",
    "tmplog_name": "tmplog.txt",
    "crashlog_name": "crashlog.txt",
    "tsv_name": "md5.txt",
    "trigger_name": "trigger.txt",
    "qualicheck_name": "qualicheck.txt",
    "source_whitelist": [
        "^[0-9]{6}-.*"
    ],
    "max_path_length": 230,
    "max_hash_size": 1073741824,
    "source_blacklist": [
        "^[^/]*/(?!EAV[0-9A-Z]{9})(?![^/]*\\.(pdf|txt)$).*$",
        ".*/forbidden.txt$",
        ".*/not_allowed/.*"
    ],
    "destination_blacklist": [
        "^[^/]*/trigger.txt",
        "^[^/]*/qualicheck.txt",
        "^[^/]*/done.txt",
        "^[^/]*/error.txt",
        "^[^/]*/start.txt",
        "^[^/]*/delete.txt"
    ],
    "mail": {
        "smtp_host": "localhost",
        "smtp_port": 25,
        "smtp_timeout": 30,
        "sender": "From <from@example.net>",
        "reply_to": "Reply-To <reply-to@example.net>",
        "subject": "Cirdan: Copied % into import directory",
        "body": "Hello User,\n\nThe upload has finished.\n\nSource: %\nTotal bytes: %\nTotal files: %\nNot copied: %\nCurrupted files: %\n\nRegards,\nCirdan\n"
    }
}