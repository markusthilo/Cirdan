{
    "paths": {
        "Windows": {
            "labels_path": "$APP/labels_de.json",
            "local_path": "$HOME/AppData/Local/Cirdan/",
            "target_path": "$HOME/Documents/",
            "log_path": "$HOME/Documents/_logs/",
            "update_path": "$HOME/Documents/_dist/Cirdan/"
        },
        "Linux": {
            "labels_path": "$APP/labels_de.json",
            "local_path": "$HOME/.config/Cirdan/",
            "target_path": "$HOME/Documents/",
            "log_path": "$HOME/Documents/_logs/",
            "update_path": "$HOME/Documents/_dist/Cirdan/"
        }
    },
    "domain": "example.net",
    "settings_name": "settings.json",
    "destinations": {
        "Import 1": {"sub_path": "import1", "todo": "selection"},
        "Import 2": {"sub_path": "import2", "todo": "static"},
        "Import 3": {"sub_path": "import3", "todo": "static"}
    },
    "todo": {
        "static": {
            "Only task": {
                "trigger_name": "ready.txt",
                "meta_name": "%y%m%d_%H%M%S_metadata.txt",
                "meta_content": "{\n    \"task\": 0\n    \"paths_count\": %p\n}",
                "delete_name": "not_ready.txt"
            },
            "Do nothing": {
                "trigger_name": "not_ready.txt",
                "meta_name": null,
                "meta_content": null,
                "delete_name": null
            }
        },
        "selection": {
            "Task 1": {
                "trigger_name": "ready.txt",
                "meta_name": "%y%m%d_%H%M%S_metadata.txt",
                "meta_content": "{\n    \"task\": 1,\n    \"paths_count\": %p\n}",
                "delete_name": "not_ready.txt"
            },
            "Task 2": {
                "trigger_name": "ready.txt",
                "meta_name": "%y%m%d_%H%M%S_metadata.txt",
                "meta_content": "{\n    \"task\": 2\n}",
                "delete_name": "not_ready.txt"
            },
            "Task 3": {
                "trigger_name": "ready.txt",
                "meta_name": "%y%m%d_%H%M%S_metadata.txt",
                "meta_content": "{\n    \"task\": 3\n}",
                "delete_name": "not_ready.txt"
            },
            "Do nothing": {
                "trigger_name": "not_ready.txt",
                "meta_name": null,
                "meta_content": null,
                "delete_name": null
            }
        }
    },
    "create_todo_name": "not_ready.txt",
    "log_name": "log.txt",
    "lastlog_name": "lastlog.txt",
    "crashlog_name": "crashlog.txt",
    "tsv_name": "%y%m%d_%H%M%S_md5.txt",
    "id": "{\"hostname\": \"%h\", \"username\": \"%u\"}",
    "source_whitelist": [
        "^[0-9]{6}-([0-9]{4}|[0-9]{6})-(([iZ0-9][0-9]{5})|(StA[0-9]{3}))/(EAV|MSD)[0-9]{2}[A-Z]{3}[0-9A-Z]{4}.*"
    ],
    "max_path_length": 230,
	"max_hash_size": 1073741824,
    "source_blacklist": [
        "^[^/]+/(?!((EAV|MSD)[0-9]{2}[A-Z]{3}[0-9A-Z]{4})|(.*\\.(txt|pdf)$))",
        ".*/Help/HTML5/.*",
        ".*/Help/LicenseUpgrade/.*"
    ],
    "destination_blacklist": [
        "^[^/]*/ready.txt$",
        "^[^/]*/error.txt$",
        "^[^/]*/start.txt$",
        "^[^/]*/delete.txt$"
    ],
    "count_paths": [
        ".*/aw_iped$",
        ".*\\.E01$",
        ".*/python.*"
    ],
	"mail": {
        "smtp_host": "smtpt.example.net",
        "smtp_port": 25,
        "smtp_timeout": 30,
        "From": "From <from@example.net>",
        "Reply-To": "reply-to@example.net",
        "Default-Subject": "Cirdan: upload has finished",
        "body": "Dear user,\n\nthis is message generated by Cirdan, the upload tool for geeks.\n\nThe upload is complete.\n\nDirectory: %\nSize: %\nFiles: %\nNot copied: %\nCorrupt files: %\n\nRegards,\n\nSupport-Team\n"
    }
}
